{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Tray",
  "version": "0.1.0",
  "identifier": "dev.quotatray.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Quota Tray",
        "width": 360,
        "height": 520,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quota Tray",
    "homepage": "https://github.com/lovinmaxwell/claude-tracker",
    "copyright": "Copyright (c) 2026 Quota Tray contributors",
    "category": "Utility",
    "shortDescription": "Local tray app for Claude Code, Cursor, and GitHub Copilot quota.",
    "longDescription": "Quota Tray shows remaining AI coding quota for Claude Code, Cursor, and GitHub Copilot in one system tray. Credentials stay on this machine. No Quota Tray servers or telemetry.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "compression": "zlib",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Quota Tray"
      }
    }
  }
}
